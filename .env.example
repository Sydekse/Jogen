# Backend Environment Variables Template (.env.example)

ENVIRONMENT=production
DEBUG=False
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

ALLOWED_HOSTS=localhost,127.0.0.1,api.jogen.et,jogen.et
FRONTEND_URL=https://jogen.et
BACKEND_URL=https://api.jogen.et

# CORS & CSRF
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://jogen.et,https://www.jogen.et
CSRF_TRUSTED_ORIGINS=https://jogen.et,https://api.jogen.et

# Database (PostgreSQL / Supabase / Neon / Render)
DATABASE_URL=postgresql://jogen_user:jogen_password@localhost:5432/jogen_db
# Or individual DB credentials if DATABASE_URL is not provided:
POSTGRES_DB=jogen_db
POSTGRES_USER=jogen_user
POSTGRES_PASSWORD=jogen_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Chapa Payment Gateway Credentials
CHAPA_SECRET_KEY=CHASECK_TEST-your-chapa-secret-key

# LiveKit WebRTC Credentials
LIVEKIT_API_KEY=API-key
LIVEKIT_API_SECRET=API-secret
LIVEKIT_URL=wss://your-livekit-server-domain.livekit.cloud

# AI / Gemini API Keys
GEMINI_API_KEY=your-gemini-api-key

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
